[Unit]
Description=Durable News Agent UI (dna-client-browser hub)
After=network-online.target dna-api.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__
ExecStart=__NODE__ --import tsx hub/src/main.ts --device __DEVICE__
Environment=PATH=__PATH__
Environment=HOME=__HOME__
Environment=NODE_NO_WARNINGS=1
Environment=DNA_HUB_HOST=0.0.0.0
Environment=DNA_HUB_PORT=__HUB_PORT__
Environment=DNA_HUB_HOSTS=__HUB_HOSTS__
Environment=DNA_API_URL=__API_URL__
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=append:__LOG__
StandardError=append:__LOG__

[Install]
WantedBy=multi-user.target
